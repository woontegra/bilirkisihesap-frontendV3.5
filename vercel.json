{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.bilirkisihesap.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://api.bilirkisihesap.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=6144"
    }
  }
}
