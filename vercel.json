{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://api.bilirkisihesap.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://api.bilirkisihesap.com/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "build": {
    "env": {
      "VITE_API_URL": "https://api.bilirkisihesap.com",
      "NODE_OPTIONS": "--max-old-space-size=6144"
    }
  }
}
