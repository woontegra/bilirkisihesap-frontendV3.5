# mock | api — varsayılan: api (mevcut backend endpointleri)
VITE_DATA_SOURCE=api
# Boş bırakın: dev'de Vite proxy, Vercel'de vercel.json /api rewrite kullanır.
# Doğrudan API: https://api.bilirkisihesap.com
VITE_API_URL=
# Akıllı Puantaj İçe Aktarma V2 (varsayılan kapalı). Development'ta açmak için: true
VITE_SMART_IMPORT_V2=
# Abonelik yenileme API'si (V3 ile aynı davranış için true)
VITE_SUBSCRIPTION_RENEWAL_ENABLED=true
# Geçici Yandex Metrica (hesaplama UX incelemesi). Açmak: true. Kapatmak: false
VITE_YANDEX_METRICA_ENABLED=
VITE_YANDEX_METRICA_ID=112580132
